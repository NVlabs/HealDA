# HealDA configuration template. Copy to `.env` and fill in what your training
# configuration needs; every setting is read by `healda.config.environment`.
#
# Each store is a `<NAME>` path plus an optional `<NAME>_PROFILE`. A profile names
# an rclone remote in ~/.config/rclone/rclone.conf; leave it empty for local paths.
# Each store carries its own, so two stores can sit on different backends.

##############
# Core paths #
##############
# PROJECT_ROOT is the default parent of DATA_ROOT and CHECKPOINT_ROOT. Leaving it
# empty makes both relative to the working directory, which is rarely intended.
PROJECT_ROOT=
DATA_ROOT=
CHECKPOINT_ROOT=
# Defaults to ~/.cache.
# HEALDA_CACHE_ROOT=

################
# Observations #
################
# Prepared UFS archive: channel_table.parquet plus <sensor>/YYYYMMDD/0.parquet.
# Needed only by UFS recipes; NNJA recipes use NNJA_ROOT alone. See
# docs/observations.md.
UFS_OBS_PATH=
UFS_OBS_PROFILE=

# Prepared NNJA archive; every path below it is derived from this one root.
NNJA_ROOT=

##########################
# ERA5 state, packed HPX #
##########################
ERA5_HPX64_104CH_ZARR=
ERA5_HPX64_104CH_ZARR_PROFILE=

################################
# ERA5 state, hourly 0.25 deg  #
################################
# HDF5 year files. ERA5_HOURLY_73CH defaults to ERA5_HOURLY_ROOT; set it only to
# point the packed channels somewhere else. Each takes a `:`-separated list.
ERA5_HOURLY_ROOT=
ERA5_HOURLY_73CH=
# One directory per variable: ERA5_HOURLY_EXT_ROOT/<variable>/<year>.h5
ERA5_HOURLY_EXT_ROOT=

#######
# UFS #
#######
UFS_HPX6_ZARR=
UFS_ZARR_PROFILE=
UFS_LAND_DATA_ZARR=
UFS_LAND_DATA_PROFILE=
